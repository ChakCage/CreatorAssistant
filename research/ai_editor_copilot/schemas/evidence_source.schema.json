{
  "$defs": {
    "RawPoint": {
      "additionalProperties": false,
      "description": "ASR zero-duration evidence is preserved, but cannot be an executable clip alone.",
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "RawPoint",
      "type": "object"
    },
    "RawSegment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "$ref": "#/$defs/RawPoint"
            }
          ],
          "title": "Range"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/Word"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "id",
        "range",
        "text"
      ],
      "title": "RawSegment",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "description": "Seconds, half-open [start, end), relative to the referenced source.",
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeRange",
      "type": "object"
    },
    "Word": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "word": {
          "title": "Word",
          "type": "string"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        }
      },
      "required": [
        "start",
        "end",
        "word"
      ],
      "title": "Word",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "transcript_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Transcript Sha256",
      "type": "string"
    },
    "duration": {
      "exclusiveMinimum": 0,
      "title": "Duration",
      "type": "number"
    },
    "language": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "backend": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "model": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/RawSegment"
      },
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "id",
    "sha256",
    "transcript_sha256",
    "duration",
    "language",
    "backend",
    "model",
    "ingested_at",
    "segments"
  ],
  "title": "EvidenceSource",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-editor-copilot:evidence_source:1.0"
}
