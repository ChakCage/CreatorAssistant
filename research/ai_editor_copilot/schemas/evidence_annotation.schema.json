{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source_segment_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Segment Ids",
          "type": "array"
        },
        "evidence_start": {
          "minimum": 0,
          "title": "Evidence Start",
          "type": "number"
        },
        "evidence_end": {
          "exclusiveMinimum": 0,
          "title": "Evidence End",
          "type": "number"
        }
      },
      "required": [
        "source_segment_ids",
        "evidence_start",
        "evidence_end"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "type": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    },
    "status": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceRef"
    },
    "generator": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Generator",
      "type": "string"
    },
    "model": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "type",
    "value",
    "status",
    "confidence",
    "evidence",
    "generator",
    "model",
    "created_at"
  ],
  "title": "Annotation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-editor-copilot:evidence_annotation:1.0"
}
